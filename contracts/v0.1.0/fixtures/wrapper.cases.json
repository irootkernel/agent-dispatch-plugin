{
  "cases": [
    {
      "id": "wrapper-valid-success",
      "description": "A complete successful plugin wrapper embedding a validated envelope.",
      "expect": "valid",
      "instance": {
        "schema_version": "agent-dispatch-plugin.result/v1",
        "ok": true,
        "operation": "agent_dispatch_status",
        "exit_code": 0,
        "agent_dispatch": {
          "api_version": "agent-dispatch.cli/v1",
          "command": "status",
          "ok": true,
          "result": {
            "routes": []
          },
          "warnings": [],
          "trace_id": ""
        },
        "diagnostics": []
      }
    },
    {
      "id": "wrapper-valid-domain-rejection",
      "description": "A bounded domain rejection wrapper for a not-found exit.",
      "expect": "valid",
      "instance": {
        "schema_version": "agent-dispatch-plugin.result/v1",
        "ok": false,
        "operation": "agent_dispatch_dispatches",
        "exit_code": 4,
        "agent_dispatch": {
          "api_version": "agent-dispatch.cli/v1",
          "command": "dispatches show",
          "ok": false,
          "error": {
            "code": "not_found",
            "category": "usage",
            "message": "no dispatch with id does-not-exist",
            "retryable": false
          },
          "trace_id": ""
        },
        "diagnostics": [
          "dispatch not found"
        ]
      }
    },
