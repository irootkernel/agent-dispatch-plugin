{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch-plugin:contracts:v0.1.0:input:agent_dispatch_dispatches",
  "title": "agent_dispatch_dispatches input",
  "description": "action selects list with documented filters or show for one redacted lineage. Filters apply to list only; dispatch_id applies to show only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {"enum": ["list", "show"]},
    "dispatch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "maxLength": 128
    },
    "route": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "maxLength": 128
    },
    "state": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25},
    "offset": {"type": "integer", "minimum": 0, "maximum": 1000000}
  },
  "required": ["action"],
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "list"}}, "required": ["action"]},
      "then": {"not": {"required": ["dispatch_id"]}}
    },
    {
      "if": {"properties": {"action": {"const": "show"}}, "required": ["action"]},
      "then": {
        "required": ["dispatch_id"],
        "not": {
          "anyOf": [
            {"required": ["route"]},
            {"required": ["state"]},
            {"required": ["limit"]},
            {"required": ["offset"]}
          ]
        }
      }
    }
  ]
}
